{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/stitch-and-scale run build",
  "outputDirectory": "artifacts/stitch-and-scale/dist/public",
  "framework": null,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type, MCP-Protocol-Version" },
        { "key": "Vary", "value": "Origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/((?!api|manifest.json|manifest.webmanifest|sw.js|assets|favicon.ico|robots.txt).*)$", "destination": "/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
